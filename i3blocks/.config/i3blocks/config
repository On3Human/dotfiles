separator=true
separator_block_width=15

[playerctl]
interval=persist
command=stdbuf -i0 -e0 -o0 playerctl metadata --follow --format '{{ emoji(status) }} {{ artist }} - {{ title }}' | sed -u 's/\xef\xb8\x8f//g'

[systemd]
command=~/dotfiles/scripts/systmed_failure_detector.sh
interval=15

[packages]
command=checkupdates | wc -l
interval=300

[keymap]
command=xkb-switch; stdbuf -oL xkb-switch -W
interval=persist

[cpu]
min_width=25
command=~/dotfiles/scripts/cpu.sh
interval=2
color=#fabd2f

[memory]
command=~/dotfiles/scripts/memory.sh
interval=5
color=#8ec07c

[disk]
command=~/dotfiles/scripts/disk.sh
interval=30
color=#83a598

[volume]
command=~/dotfiles/scripts/volume.sh
interval=once
signal=10
color=#d3869b

[network]
command=~/dotfiles/scripts/network.sh
interval=10
color=#8ec07c

[weather]
command=~/dotfiles/scripts/weather.sh
interval=1800
color=#fe8019

[battery]
command=~/dotfiles/scripts/battery.sh
interval=30
color=#fe8019

[time]
command=date '+%Y-%m-%d %H:%M'
interval=5
color=#ebdbb2
